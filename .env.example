# ---- required ----
DISCORD_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# ---- recommended ----
# Your test/main server ID: commands appear instantly instead of after ~1 hour
GUILD_ID=
# Your Discord user ID(s), comma separated (anti-nuke owner override)
OWNER_IDS=

# ---- brand ----
BRAND_NAME=AxionHost

# ---- self-hosted AI (Ollama on your own VPS) ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
AI_LANG=hinglish
AI_CONCURRENCY=1
KB_PATH=kb.md

# 1 = bot auto-creates the animated emoji pack on startup, 0 = only via /emoji install
AUTO_EMOJIS=1

# ---- bot hosting mode (panel / Pterodactyl): AI runs on your VPS ----
# OLLAMA_URL=http://YOUR_VPS_IP:11434
# OLLAMA_TOKEN=            # only if you put a token-checking proxy in front of Ollama

# ---- Meta AI (set this and the bot uses Meta instead of Ollama; leave empty to keep using Ollama) ----
META_API_KEY=
# Meta Responses API endpoint + model (from the Meta quickstart)
META_API_URL=https://api.meta.ai/v1/responses
META_MODEL=muse-spark-1.3

# Groq (free tier, fast). If set, it is used instead of Meta/Ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
